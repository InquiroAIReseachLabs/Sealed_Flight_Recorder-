{"baseline":{"firmware":"1.17.0 d6f12ad1c4f70ad3230afd7d86e971421e02fef4","ignore":["COM_FLIGHT_UUID","LND_FLIGHT_T_HI","LND_FLIGHT_T_LO","EKF2_MAG_DECL","CAL_BARO*_OFF","ASPD_SCALE_*","COM_MODE*_HASH"],"parameters":{"COM_DISARM_LAND":"i32:2","SYS_AUTOSTART":"i32:10040"}},"config":{"firmware":"1.17.0","parameters":{"COM_DISARM_LAND":"i32:2","SYS_AUTOSTART":"i32:10040"},"watched_parameters":["VT_ARSP_TRANS","VT_B_TRANS_DUR","VT_FW_DIFTHR_EN","VT_FW_DIFTHR_S_P","VT_FW_DIFTHR_S_R","VT_FW_DIFTHR_S_Y","VT_F_TRANS_DUR","VT_PITCH_MIN","VT_TRANS_MIN_TM","VT_TRANS_TIMEOUT"]},"events":[{"boot_us":"1000000","index":0,"instance":0,"kind":"NAV_STATE_CHANGE","new":4,"new_name":"AUTO_LOITER","old":null,"old_name":null,"seq":0,"topic":"vehicle_status","utc_us":null},{"boot_us":"2000000","index":1,"initial":false,"instance":0,"kind":"ARM","reason":3,"reason_name":"command_internal","seq":1,"topic":"vehicle_status","utc_us":null},{"boot_us":"7000000","index":6,"instance":0,"kind":"DISARM","reason":6,"reason_name":"auto_disarm_land","seq":2,"topic":"vehicle_status","utc_us":null}],"log":{"blake3":"025a921c1bb6477300aef7809847c229f7c9af45fcdfd979f25b8a403ed462ad","file_name":"custom_detection.ulg","firmware":{"git":"d6f12ad1c4f70ad3230afd7d86e971421e02fef4","ver_sw_release":"0x011100ff","version":"1.17.0"},"sha256":"80fb3f281fb9642a75e8289d9080a24be85669328d4f044cafdb3da68d4ae108","size":"1338","vehicle":{"is_vtol":false,"system_type":2,"vtol_type":null}},"merkle":{"algorithm":"sha256-rfc6962","leaf_count":18,"root":"f0dfbb9f3f3ead1bb18d089940262642b05ff1bc2f259ee4116e0a1b1928a8d0","sections":{"baseline":1,"config":1,"events":3,"log":1,"results":7,"rules":1,"seal_context":1,"sealed_topics":3}},"results":[{"detail":[],"expected":"data records for vehicle_status, failsafe_flags, custom_detection, and the fields the core rules read","found":"all present","id":"R1","name":"required topics present","status":"PASS"},{"detail":[],"expected":"1.17.0 d6f12ad1c4f70ad3230afd7d86e971421e02fef4","found":"1.17.0 d6f12ad1c4f70ad3230afd7d86e971421e02fef4","id":"R2","name":"firmware matches baseline","status":"PASS"},{"detail":[],"expected":"every parameter in the baseline or the log equal, 0 ignored by pattern","found":"no differences","id":"R3","name":"parameters match baseline","status":"PASS"},{"detail":[],"expected":"vehicle_status.failsafe false in flight (from ARM through the sample that disarms), and no quadchute (fixed wing straight to multicopter) in flight","found":"never true in flight","id":"R4","name":"no failsafe in flight","status":"PASS"},{"detail":[],"expected":"every ARM followed by a DISARM; log does not end armed","found":"1 ARM, 1 DISARM","id":"R5","name":"arm and disarm consistent","status":"PASS"},{"detail":[],"expected":"every VTOL transition START has an END; none aborted","found":"vehicle_status.is_vtol false on every sample","id":"R6","name":"VTOL transitions completed","status":"N/A"},{"detail":[],"expected":"every COMMAND event from a source in [authorized_sources]","found":"no [authorized_sources] in the rules file","id":"R7","name":"authorized command sources","status":"N/A"}],"rules":{"sha256":"9be2006df62a49bc56dab5329bb750ec01ec6b0bf4f39141fd27901252f27e87","text":"# sfr rules file: core rules R1 to R6; R7 is N/A without [authorized_sources].\n# Format reference: docs/SPEC.md B1.6. Unknown keys are rejected.\nformat = \"sfr-rules/1\"\n\n[required_topics]\n# R1 also checks the vehicle_status and failsafe_flags fields that R4 to R6 read.\ntopics = [\"vehicle_status\", \"failsafe_flags\"]\n\n[parameters]\n# \"all\": a parameter present only in the baseline or only in the log is a difference.\n# \"baseline\": compare only the parameters the baseline lists.\ncompare = \"all\"\n\n# R3 skips parameters matching these patterns. \"*\" matches any run of characters.\n# Default list from two flights with no change between them (testdata/sitl/v1.17.0/mc_flight_1\n# and mc_flight_2) plus the PX4 parameter definitions (docs/RULES.md, R3).\nignore = [\n  \"COM_FLIGHT_UUID\",   # per-flight identifier\n  \"LND_FLIGHT_T_HI\",   # flight-time accumulator\n  \"LND_FLIGHT_T_LO\",   # flight-time accumulator\n  \"EKF2_MAG_DECL\",     # learned from position each flight\n  \"CAL_BARO*_OFF\",     # rewritten by GNSS baro auto-calibration (v1.17)\n  \"ASPD_SCALE_*\",      # airspeed scale learned in flight\n  \"COM_MODE*_HASH\",    # external mode registration hashes (v1.15 and later)\n]\n\n# Watched parameters (SPEC B1.6): R3 compares them like every other parameter; the\n# results table and the report show them in their own \"Transition tuning\" section, and the\n# record lists them in config.watched_parameters. VTOL transition tuning; every name is defined\n# in PX4 v1.14 and v1.17 (docs/RULES.md, R3).\n[watched_parameters]\nnames = [\n  \"VT_F_TRANS_DUR\",    # front transition duration\n  \"VT_B_TRANS_DUR\",    # maximum back transition duration\n  \"VT_TRANS_MIN_TM\",   # front transition minimum time\n  \"VT_TRANS_TIMEOUT\",  # front transition timeout\n  \"VT_ARSP_TRANS\",     # transition airspeed\n  \"VT_PITCH_MIN\",      # minimum pitch angle during hover\n  \"VT_FW_DIFTHR_EN\",   # differential thrust in forward flight (bitmask)\n  \"VT_FW_DIFTHR_S_R\",  # roll differential thrust factor\n  \"VT_FW_DIFTHR_S_P\",  # pitch differential thrust factor\n  \"VT_FW_DIFTHR_S_Y\",  # yaw differential thrust factor\n]\n\n# COMMAND events with these ids are category PAYLOAD; every other command is GENERAL.\n# Ids and names from PX4's VehicleCommand.msg, the same in v1.14 and v1.17 (docs/RULES.md,\n# R7). Flight termination (185) and parachute (208) are safety commands and stay GENERAL.\n[payload_commands]\nids = [\n  184,    # VEHICLE_CMD_DO_REPEAT_SERVO\n  187,    # VEHICLE_CMD_DO_SET_ACTUATOR\n  203,    # VEHICLE_CMD_DO_DIGICAM_CONTROL\n  206,    # VEHICLE_CMD_DO_SET_CAM_TRIGG_DIST\n  211,    # VEHICLE_CMD_DO_GRIPPER\n  214,    # VEHICLE_CMD_DO_SET_CAM_TRIGG_INTERVAL\n  260,    # VEHICLE_CMD_OBLIQUE_SURVEY\n  2000,   # VEHICLE_CMD_IMAGE_START_CAPTURE\n  2003,   # VEHICLE_CMD_DO_TRIGGER_CONTROL\n  30001,  # VEHICLE_CMD_PAYLOAD_PREPARE_DEPLOY\n  30002,  # VEHICLE_CMD_PAYLOAD_CONTROL_DEPLOY\n  42600,  # VEHICLE_CMD_DO_WINCH\n]\n\n# Golden fixture (SPEC B1.6): seal a topic PX4 does not define.\n[sealed_topics]\ntopics = [\"custom_detection\"]\n"},"schema_version":3,"seal":{"allow_untested_version":false,"certificate_chain":null,"crypto_crates":[{"name":"blake3","version":"1.8.7"},{"name":"ed25519-dalek","version":"3.0.0"},{"name":"sha2","version":"0.11.1"}],"key_custody":"file-evaluation","key_fingerprint":"sha256:5c085c6ec6c9fb6ac334e98a45ec082308fc9c754b85dbd9101cc5629a999ab6","key_label":"sfr.key","signer_certificate":null,"time_utc":"2026-10-18T15:00:00Z"},"sealed_topics":[{"data_sha256":"464b4c4a95fa5423869d3d7ae29db43e7939c02ca472699662b6bce7d52d2185","first_timestamp_us":"3000500","format_sha256":"85907f874cb6b535d5a9ce8635f7e6032cf3c454b12174aa190283dc42fca47e","last_timestamp_us":"7000500","message_count":5,"multi_id":0,"topic":"custom_detection"},{"data_sha256":"49486f16862247151ca1be9e892b4b9ca0bb0cb7ee15fc1958567fe53891649b","first_timestamp_us":"4000700","format_sha256":"85907f874cb6b535d5a9ce8635f7e6032cf3c454b12174aa190283dc42fca47e","last_timestamp_us":"6000700","message_count":2,"multi_id":1,"topic":"custom_detection"},{"data_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","first_timestamp_us":null,"format_sha256":"85907f874cb6b535d5a9ce8635f7e6032cf3c454b12174aa190283dc42fca47e","last_timestamp_us":null,"message_count":0,"multi_id":2,"topic":"custom_detection"}],"signature":{"algorithm":"ed25519","value":"05d07589a9f56f8aa39f650c5d33d280c50a7d3859c0e6d825a3e0b89b77d98f386aa1e02eacb5c2f2ac6dc3c8ab6dec69c6674e9dbca5073ea4df3c3812df09"},"status":"PASS","tool":{"build_commit":"unknown","name":"sfr","version":"0.1.0"}}