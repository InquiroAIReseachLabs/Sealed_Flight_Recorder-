# Build output
/target/
/fuzz/target/
/fuzz/artifacts/
/fuzz/corpus/
/site/pkg/
# The browser test's npm packages (tests/browser/package-lock.json pins them).
/tests/browser/node_modules/

# Private keys never enter the repository (SPEC B1.9).
*.key
/keys/

# Local-only list of forbidden terms for scripts/check_language.sh (SPEC B1.12).
# Kept out of the repository on purpose: the names it holds must not appear anywhere in it.
.forbidden-terms

# Editor and OS noise
.idea/
.vscode/
*.swp
.DS_Store

# Python bytecode from scripts/
__pycache__/

# Release artifacts and their staging (scripts/build_release.sh and the CI release jobs).
/dist/
# cargo-cyclonedx writes SBOMs next to each crate; scripts/release_sbom.sh moves them out.
*.cdx.json
