,"command":21,"index":6,"instance":0,"kind":"COMMAND","result":"ACCEPTED","seq":15,"source_component":1,"source_system":1,"topic":"vehicle_command","utc_us":null},{"boot_us":"62160000","index":131,"instance":0,"kind":"NAV_STATE_CHANGE","new":18,"new_name":"AUTO_LAND","old":4,"old_name":"AUTO_LOITER","seq":16,"topic":"vehicle_status","utc_us":null},{"boot_us":"62412000","category":"GENERAL","command":1001,"index":7,"instance":0,"kind":"COMMAND","result":"NO_ACK","seq":17,"source_component":1,"source_system":1,"topic":"vehicle_command","utc_us":null},{"boot_us":"62412000","category":"GENERAL","command":1000,"index":8,"instance":0,"kind":"COMMAND","result":"NO_ACK","seq":18,"source_component":1,"source_system":1,"topic":"vehicle_command","utc_us":null},{"boot_us":"62412000","category":"GENERAL","command":1001,"index":9,"instance":0,"kind":"COMMAND","result":"NO_ACK","seq":19,"source_component":1,"source_system":1,"topic":"vehicle_command","utc_us":null},{"boot_us":"88272000","index":185,"instance":0,"kind":"DISARM","reason":6,"reason_name":"auto_disarm_land","seq":20,"topic":"vehicle_status","utc_us":null},{"boot_us":"88272000","index":185,"instance":0,"kind":"NAV_STATE_CHANGE","new":4,"new_name":"AUTO_LOITER","old":18,"old_name":"AUTO_LAND","seq":21,"topic":"vehicle_status","utc_us":null}],"log":{"blake3":"0af5378155f2d8dc440697a01096d4af50217c6eb33f93b3bef3d976a54adbfd","file_name":"vtol_transition.ulg","firmware":{"git":"d6f12ad1c4f70ad3230afd7d86e971421e02fef4","ver_sw_release":"0x011100ff","version":"1.17.0"},"sha256":"86d64e54d1261991f4035355550f64e017f8a486c5c665848d6e68ae67fc9bf3","size":"24295307","skipped":{"orphan_data_records":0,"region_bytes":"0","regions":0,"unknown_records":0},"vehicle":{"is_vtol":true,"system_type":22,"vtol_type":{"name":"standard","value":2}},"vehicle_status_instances":1},"merkle":{"algorithm":"sha256-rfc6962","leaf_count":34,"root":"c06eaae1216ad381fe01b6d21a2a7b983e49d0c96f91cc18bb7fa6b4a13242cf","sections":{"baseline":1,"config":1,"events":22,"log":1,"results":7,"rules":1,"seal_context":1,"sealed_topics":0}},"results":[{"detail":[],"expected":"data records for vehicle_status, failsafe_flags, and the fields the core rules read","found":"all present","id":"R1","name":"required topics present","status":"PASS"},{"detail":[],"expected":"1.17.0 d6f12ad1c4f70ad3230afd7d86e971421e02fef4, from the baseline's # Firmware: line","found":"log states PX4 1.17.0 d6f12ad1c4f70ad3230afd7d86e971421e02fef4 (self-reported); baseline file sha256 d4da23c173b4031487e802b4971921f834d255f1eb47c4906228cb93edf18885 (operator-supplied)","id":"R2","name":"firmware matches baseline","status":"PASS"},{"detail":[],"expected":"every parameter in the baseline or the log equal to the baseline at every ARM, none changed in flight, 10 ignored by pattern","found":"no differences; ignore [COM_FLIGHT_UUID, LND_FLIGHT_T_HI, LND_FLIGHT_T_LO, EKF2_MAG_DECL, CAL_BARO*_OFF, ASPD_SCALE_*, COM_MODE*_HASH] suppressed 1 difference(s); baseline file sha256 d4da23c173b4031487e802b4971921f834d255f1eb47c4906228cb93edf18885 (operator-supplied)","id":"R3","name":"parameters match baseline","status":"PASS"},{"detail":["warning: failsafe_flags.auto_mission_missing true in flight from boot_us 4892000 (155 sample(s)), not required by the nav_state in effect","warning: failsafe_flags.gcs_connection_lost true in flight from boot_us 4892000 (155 sample(s)), not required by the nav_state in effect","warning: failsafe_flags.manual_control_signal_lost true in flight from boot_us 4892000 (155 sample(s)), not required by the nav_state in effect","warning: failsafe_flags.offboard_control_signal_lost true in flight from boot_us 4892000 (155 sample(s)), not required by the nav_state in effect"],"expected":"vehicle_status.failsafe false in flight (from ARM through the sample that disarms), no quadchute (fixed wing straight to multicopter) in flight, and no failsafe_flags flag that the current nav_state requires true in flight; other failsafe_flags flags true in flight are warnings","found":"never true in flight; warning: failsafe_flags auto_mission_missing, gcs_connection_lost, manual_control_signal_lost, offboard_control_signal_lost true in flight","id":"R4","name":"no failsafe in flight","status":"WARN"},{"detail":[],"expected":"every ARM followed by a DISARM; log does not end armed","found":"1 ARM, 1 DISARM","id":"R5","name":"arm and disarm consistent","status":"PASS"},{"detail":["VTOL type standard (VT_TYPE 2)"],"expected":"every VTOL transition START has an END; none aborted","found":"2 START, 2 END, 0 problem(s)","id":"R6","name":"VTOL transitions completed","status":"PASS"},{"detail":[],"expected":"every COMMAND event from a source in [authorized_sources]","found":"no [authorized_sources] in the rules file","id":"R7","name":"authorized command sources","status":"N/A"}],"rules":{"sha256":"d999f656c0a35ca19dd4804c9bc9f0bed30b5009f06a494ffc345f79ff9cc240","text":"# sfr rules file: core rules R1 to R6; R7 is N/A without [authorized_sources].\n# Format reference: docs/SPEC.md B1.6. Unknown keys are rejected.\nformat = \"sfr-rules/1\"\n\n[required_topics]\n# R1 also checks the vehicle_status and failsafe_flags fields that R4 to R6 read.\ntopics = [\"vehicle_status\", \"failsafe_flags\"]\n\n[parameters]\n# \"all\": a parameter present only in the baseline or only in the log is a difference.\n# \"baseline\": compare only the parameters the baseline lists.\ncompare = \"all\"\n\n# R3 skips parameters matching these patterns. \"*\" matches any run of characters.\n# Default list from two flights with no change between them (testdata/sitl/v1.17.0/mc_flight_1\n# and mc_flight_2) plus the PX4 parameter definitions (docs/RULES.md, R3).\nignore = [\n  \"COM_FLIGHT_UUID\",   # per-flight identifier\n  \"LND_FLIGHT_T_HI\",   # flight-time accumulator\n  \"LND_FLIGHT_T_LO\",   # flight-time accumulator\n  \"EKF2_MAG_DECL\",     # learned from position each flight\n  \"CAL_BARO*_OFF\",     # rewritten by GNSS baro auto-calibration (v1.17)\n  \"ASPD_SCALE_*\",      # airspeed scale learned in flight\n  \"COM_MODE*_HASH\",    # external mode registration hashes (v1.15 and later)\n]\n\n# Watched parameters (SPEC B1.6): R3 compares them like every other parameter; the\n# results table and the report show them in their own \"Transition tuning\" section, and the\n# record lists them in config.watched_parameters. VTOL transition tuning; every name is defined\n# in PX4 v1.14 and v1.17 (docs/RULES.md, R3).\n[watched_parameters]\nnames = [\n  \"VT_F_TRANS_DUR\",    # front transition duration\n  \"VT_B_TRANS_DUR\",    # maximum back transition duration\n  \"VT_TRANS_MIN_TM\",   # front transition minimum time\n  \"VT_TRANS_TIMEOUT\",  # front transition timeout\n  \"VT_ARSP_TRANS\",     # transition airspeed\n  \"VT_PITCH_MIN\",      # minimum pitch angle during hover\n  \"VT_FW_DIFTHR_EN\",   # differential thrust in forward flight (bitmask)\n  \"VT_FW_DIFTHR_S_R\",  # roll differential thrust factor\n  \"VT_FW_DIFTHR_S_P\",  # pitch differential thrust factor\n  \"VT_FW_DIFTHR_S_Y\",  # yaw differential thrust factor\n]\n\n# COMMAND events with these ids are category PAYLOAD; every other command is GENERAL.\n# Ids and names from PX4's VehicleCommand.msg, the same in v1.14 and v1.17 (docs/RULES.md,\n# R7). Flight termination (185) and parachute (208) are safety commands and stay GENERAL.\n[payload_commands]\nids = [\n  184,    # VEHICLE_CMD_DO_REPEAT_SERVO\n  187,    # VEHICLE_CMD_DO_SET_ACTUATOR\n  203,    # VEHICLE_CMD_DO_DIGICAM_CONTROL\n  206,    # VEHICLE_CMD_DO_SET_CAM_TRIGG_DIST\n  211,    # VEHICLE_CMD_DO_GRIPPER\n  214,    # VEHICLE_CMD_DO_SET_CAM_TRIGG_INTERVAL\n  260,    # VEHICLE_CMD_OBLIQUE_SURVEY\n  2000,   # VEHICLE_CMD_IMAGE_START_CAPTURE\n  2003,   # VEHICLE_CMD_DO_TRIGGER_CONTROL\n  30001,  # VEHICLE_CMD_PAYLOAD_PREPARE_DEPLOY\n  30002,  # VEHICLE_CMD_PAYLOAD_CONTROL_DEPLOY\n  42600,  # VEHICLE_CMD_DO_WINCH\n]\n"},"schema_version":4,"seal":{"allow_ignore_all":false,"allow_untested_version":false,"certificate_chain":null,"crypto_crates":[{"name":"blake3","version":"1.8.7"},{"name":"ed25519-dalek","version":"3.0.0"},{"name":"sha2","version":"0.11.1"}],"key_custody":"file-evaluation","key_fingerprint":"sha256:02b520dc9b518f03929c90a58b374e69bfe501def0bea30ef8a5fd3ab37517dd","key_label":"sfr.key","signer_certificate":null,"time_utc":"2026-10-18T15:00:00Z"},"sealed_topics":[],"signature":{"algorithm":"ed25519","value":"2d5671046a03a35d5e0ceb9e676a07e0b00e7daf6d7d8f62a77dec59d02e46e9410b84d8687152be69836b87c711250faeb37f94dd29dda57c371b290ead7f02"},"status":"WARN","tool":{"build_commit":"unknown","name":"sfr","version":"0.1.0"}}